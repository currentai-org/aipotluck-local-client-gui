    "argv": [
      {
        "kind": "expression",
        "source": "str(self.newt_binary)"
      },
      {
        "kind": "literal",
        "value": "--id"
      },
      {
        "kind": "expression",
        "source": "self.tunnel_id"
      },
      {
        "kind": "literal",
        "value": "--endpoint"
      },
      {
        "kind": "expression",
        "source": "self.tunnel_endpoint"
      },
      {
        "kind": "literal",
        "value": "--health-file"
      },
      {
        "kind": "expression",
        "source": "str(health_file)"
      }
    ],
    "backoff_schedule": [
